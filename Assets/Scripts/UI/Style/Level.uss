:root {
}

.game-ui-holder {
    top: 20px;
    left: 20px;
    position: absolute;
    align-items: flex-start;
}

.score-text {
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    font-size: 56px;
    color: rgb(223, 223, 223);
    text-shadow: -3.8px 1.3px 0 rgb(0, 0, 0);
    -unity-font-style: bold;
}

.health-holder {
    height: 80px;
    margin-top: 30px;
    align-items: flex-start;
    flex-direction: row;
}

.health-icon {
    height: 80px;
    width: 80px;
    background-image: url("project://database/Assets/Art/Sprites/UI/Health_Icon.png?fileID=2800000&guid=b75ee1fb0ef6ffb42afb76c8bddff5b7&type=3#Health_Icon");
}
