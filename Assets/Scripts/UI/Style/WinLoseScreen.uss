:root {
    background-color: rgb(47, 63, 94);
}

.screen-holder {
    align-self: center;
    align-items: center;
}

.score-label {
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(255, 255, 255);
}

.panel-holder {
    margin-top: auto;
    margin-right: auto;
    margin-bottom: auto;
    margin-left: auto;
    width: 300px;
    align-items: center;
}

.condition-text {
    font-size: 128px;
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
    -unity-text-align: upper-center;
}
