:root {
    background-color: rgb(47, 63, 94);
}

.screen-holder {
    align-self: center;
    align-items: center;
}

.panel-holder {
    margin-top: auto;
    margin-right: auto;
    margin-bottom: auto;
    margin-left: auto;
    width: 300px;
}

.condition-text {
    color: rgb(98, 190, 62);
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(41, 132, 32);
}
